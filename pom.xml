<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>QuizMaster</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>QuizMaster</name>
    <description>
        JavaFX quiz application with teacher and student roles, class codes,
        timed tests and answer review. Backed by MySQL.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
          Only maven.compiler.release is set. The original POM also set
          maven.compiler.source, which is redundant: when release is present the
          compiler plugin ignores source/target.
        -->
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>25</javafx.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!--
          javafx-fxml was declared here but the project builds every screen in
          Java code and contains no .fxml files or FXMLLoader usage, so it was
          never needed. Re-add it if FXML layouts are introduced later.
        -->

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
        </dependency>

        <!--
          Used by the "Upload Questions File" feature (com.quiz.importing):
          PDFBox reads text out of PDF files and POI reads text out of Word .docx
          files. Plain .txt files are read with the JDK alone.
          Both are only reached from QuestionFileReader, so the rest of the app
          does not depend on them.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!--
          POI logs through the Log4j 2 API. With no provider on the classpath it
          prints "Log4j API could not find a logging provider" to stderr every time
          the app starts, which looks like a fault to anyone reading the console.
          These two tiny bridges route that logging to a discarding SLF4J backend,
          so the console stays clean without pulling in a logging framework.
          Neither jar is used by any application code.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-to-slf4j</artifactId>
            <version>2.24.3</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Pinned so `mvn test` reliably discovers JUnit 5 (Jupiter) tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.quiz.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
